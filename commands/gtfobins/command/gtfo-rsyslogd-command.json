{
  "id": "gtfo-rsyslogd-command",
  "name": "GTFOBins · rsyslogd (command)",
  "command": "cat >/path/to/temp-file <<EOF\nmodule(load=\"imuxsock\")\n:msg, contains, \"somerandomstring\" ^/path/to/command\nEOF\n\nrsyslogd -f /path/to/temp-file",
  "description": "Use rsyslogd to command via GTFOBins.",
  "platform": "linux",
