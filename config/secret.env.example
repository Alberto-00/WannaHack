# WannaHack - configurazione Ricerca AI
# Copia questo file in config/secret.env e metti la tua chiave.
#
# Vale per tutte le discipline (Pentest, WiFi). Quello che cambia per disciplina
# e' l'indice di comandi e playbook inviato al modello, non questi parametri.
# I valori impostati dalla modale AI restano nel localStorage del browser e
# hanno la precedenza su questo file, tranne la chiave che viene letta da qui
# se il campo e' vuoto. "Ripristina impostazioni" nella modale rilegge questo file.

# API Key (required)
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Model Configuration
# OPENAI_MODEL: qualsiasi modello chat della tua key.
# OPENAI_TEMPERATURE: 0 = risposte stabili, e' quello che serve per questa ricerca.
# OPENAI_MAX_RESULTS: quanti comandi al massimo puo' restituire.
# OPENAI_MAX_TOKENS: tetto sulla risposta; alzalo se le spiegazioni si troncano.
OPENAI_MODEL=gpt-4.1-mini-2025-04-14
OPENAI_TEMPERATURE=0
OPENAI_MAX_RESULTS=15
OPENAI_MAX_TOKENS=1000

# Behaviour
# OPENAI_WEB_SEARCH=1 richiede un modello "search" (es. gpt-5-search-api) e
# disattiva JSON rigido e temperature: piu' lenta e meno precisa.
# OPENAI_ALWAYS_EXPLAIN=1 aggiunge sempre la spiegazione breve prima dei risultati.
OPENAI_WEB_SEARCH=0
OPENAI_ALWAYS_EXPLAIN=0
